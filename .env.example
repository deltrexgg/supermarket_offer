# Copy to .env and fill in. Never commit .env.

# --- Supabase database (Project Settings > Database > Connection string > Session pooler) ---
# Use the session pooler (IPv4 compatible, port 5432), not the transaction pooler (port 6543):
# the migration runner needs a session-level advisory lock and GORM uses prepared statements.
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase Auth (Project Settings > API) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public key: safe in the browser. Used by the portal to sign in.
SUPABASE_ANON_KEY=
# Secret key: API only. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Storage via S3 (Storage > S3 Connection) ---
# Create a PUBLIC bucket named offer-media first, then generate S3 access keys.
S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=YOUR_PROJECT_REGION
S3_BUCKET=offer-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where the browser loads files from
PUBLIC_FILE_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/offer-media

# --- App ---
# Origins allowed to call the API (portal, public site, admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Proxies whose X-Forwarded-For header is believed, comma separated addresses or CIDRs.
# Leave empty unless the API runs behind a reverse proxy you control.
TRUSTED_PROXIES=
# Requests per minute per IP on the public API (0 = no limit). Registration, poster
# creation, /render and /admin have their own fixed, tighter limits.
RATE_LIMIT_PUBLIC=600
# Baked into the Next.js builds at image build time
NEXT_PUBLIC_API_URL=http://localhost:8080

# Platform owner login for the admin site (http://localhost:3002). The API creates it in
# Supabase Auth on startup if it does not exist yet. Password: 8 to 72 characters.
# Changing the password here later does not reset an existing admin; change it in Supabase.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo data: when true, the API fills an EMPTY database with Dubai demo data and creates
# demo logins in your Supabase Auth (noor@/gulf@/spice@offers.test).
# Needs SUPABASE_SERVICE_ROLE_KEY. Set back to false afterwards.
SEED=true
